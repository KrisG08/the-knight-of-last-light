root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,gdshader,tscn,tres}]
indent_style = tab
indent_size = 4

[*.{py,json,yml,yaml,toml}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{cmd,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
