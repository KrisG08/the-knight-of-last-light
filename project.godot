config_version=5

[application]
config/name="The Knight of Last Light"
config/version="0.5.66"
config/icon="res://assets/ui/last-light-icon.svg"
run/main_scene="res://game/world/runtime/village_game.tscn"

[display]
window/frame_pacing/android/enable_frame_pacing=true
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/size/viewport_width.mobile=1280
window/size/viewport_height.mobile=720

[rendering]
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=2
renderer/rendering_method="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
